; GameInput 2.2.26100.6106 runtime setup, extracted from GameInputRedist.msi.
; No MSI execution or installer dependency registration is needed.
; Keep builtin gameinput.dll. The native service currently requires missing WNF APIs.

[Version]
Signature="$CHICAGO$"

[DefaultInstall]

[DefaultInstall.ntamd64]
CopyFiles=GameInput64Files,GameInput32Files,GameInputSystem64Files,GameInputSystem32Files
AddReg=GameInputRegistry

[DefaultInstall.ntamd64.Services]
; Demand-start only: starting the native service currently crashes in ntdll.
AddService=GameInputRedistService,0,GameInputService

[GameInputService]
DisplayName="GameInput Redist Service"
Description="GameInput Redist Service"
ServiceType=16
StartType=3
ErrorControl=0
ServiceBinary="%16422%\Microsoft GameInput\x64\GameInputRedistService.exe"

[WineSourceDirs]
GameInput64Files=native\gameinput.redist,dlls\gameinput.redist
GameInput32Files=native\gameinput.redist,dlls\gameinput.redist
GameInputSystem64Files=native\gameinput.redist,dlls\gameinput.redist
GameInputSystem32Files=native\gameinput.redist,dlls\gameinput.redist

[DestinationDirs]
GameInput64Files=16422,Microsoft GameInput\x64
GameInput32Files=16422,Microsoft GameInput\x86
GameInputSystem64Files=11
GameInputSystem32Files=10,syswow64

[GameInput64Files]
GameInputRedist.dll,x64-GameInputRedist.dll
GameInputBridge.dll,x64-GameInputBridge.dll
GameInputRawInputProxy.exe,x64-GameInputRawInputProxy.exe
GameInputRedistService.exe,x64-GameInputRedistService.exe

[GameInput32Files]
GameInputRedist.dll,x86-GameInputRedist.dll

[GameInputSystem64Files]
GameInputRedist.dll,x64-GameInputRedist.dll

[GameInputSystem32Files]
GameInputRedist.dll,x86-GameInputRedist.dll

[GameInputRegistry]
; setupapi currently ignores FLG_ADDREG_32BITKEY; address the redirected key explicitly.

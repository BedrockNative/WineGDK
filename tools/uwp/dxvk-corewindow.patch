 namespace dxvk {
 
+  // Native CoreWindow interoperability, also provided by Wine's UWP host.
+  struct CoreWindowInterop : IUnknown {
+    virtual HRESULT STDMETHODCALLTYPE get_WindowHandle(HWND* window) = 0;
+    virtual HRESULT STDMETHODCALLTYPE put_MessageHandled(BOOL handled) = 0;
+  };
+  static const GUID iidCoreWindowInterop =
+    {0x45d64a29,0xa63e,0x4cb6,{0xb4,0x98,0x57,0x81,0xd2,0x98,0xcb,0x4f}};
+
+
+  // A full-window XAML composition target can use the thread's CoreWindow.
+  // Child/multiple composition surfaces still require a separate compositor.
+  struct CoreWindowStatic : IInspectable {
+    virtual HRESULT STDMETHODCALLTYPE GetForCurrentThread(IUnknown** window) = 0;
+  };
+  static HRESULT getThreadCompositionWindow(HWND* hwnd) {
+    static const GUID iidStatics =
+      {0x4d239005,0x3c2a,0x41b1,{0x90,0x22,0x53,0x6b,0xb9,0xcf,0x93,0xb1}};
+    HMODULE module = GetModuleHandleW(L"combase.dll");
+    if (!module) return E_NOINTERFACE;
+    auto createString = reinterpret_cast<HRESULT (WINAPI *)(PCNZWCH, UINT32, HSTRING*)>(GetProcAddress(module, "WindowsCreateString"));
+    auto deleteString = reinterpret_cast<HRESULT (WINAPI *)(HSTRING)>(GetProcAddress(module, "WindowsDeleteString"));
+    auto getFactory = reinterpret_cast<HRESULT (WINAPI *)(HSTRING, REFIID, void**)>(GetProcAddress(module, "RoGetActivationFactory"));
+    if (!createString || !deleteString || !getFactory) return E_NOINTERFACE;
+    HSTRING name = nullptr;
+    HRESULT hr = createString(L"Windows.UI.Core.CoreWindow", 26, &name);
+    if (FAILED(hr)) return hr;
+    Com<CoreWindowStatic> statics;
+    hr = getFactory(name, iidStatics, reinterpret_cast<void**>(&statics));
+    deleteString(name);
+    if (FAILED(hr)) return hr;
+    Com<IUnknown> window;
+    hr = statics->GetForCurrentThread(&window);
+    if (FAILED(hr) || !window) return E_NOINTERFACE;
+    Com<CoreWindowInterop> interop;
+    hr = window->QueryInterface(iidCoreWindowInterop, reinterpret_cast<void**>(&interop));
+    return FAILED(hr) ? hr : interop->get_WindowHandle(hwnd);
+  }
+

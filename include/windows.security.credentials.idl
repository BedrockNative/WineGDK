namespace Windows.Security.Credentials {
    runtimeclass PasswordCredential;

    [uuid(6ab18989-c720-41a7-a6c1-feadb36329a0), exclusiveto(Windows.Security.Credentials.PasswordCredential), contract(Windows.Foundation.UniversalApiContract, 1.0)]
    interface IPasswordCredential : IInspectable

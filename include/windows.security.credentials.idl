namespace Windows.Security.Credentials {
    typedef enum WebAccountState WebAccountState;
    typedef enum WebAccountPictureSize WebAccountPictureSize;
    runtimeclass WebAccountProvider;
    runtimeclass WebAccount;
    [contract(Windows.Foundation.UniversalApiContract,1.0)] enum WebAccountState { None=0, Connected=1, Error=2 };
    [contract(Windows.Foundation.UniversalApiContract,1.0)] enum WebAccountPictureSize { Size64x64=64, Size208x208=208, Size424x424=424, Size1080x1080=1080 };
    [uuid(29dcc8c3-7ab9-4a7c-a336-b942f9dbf7c7), exclusiveto(WebAccountProvider)]
    interface IWebAccountProvider : IInspectable {
        [propget] HRESULT Id([out,retval] HSTRING *value);
        [propget] HRESULT DisplayName([out,retval] HSTRING *value);
        [propget] HRESULT IconUri([out,retval] Windows.Foundation.Uri **value);
    }
    [uuid(4a01eb05-4e42-41d4-b518-e008a5163614), exclusiveto(WebAccountProvider)]
    interface IWebAccountProvider2 : IInspectable {
        [propget] HRESULT DisplayPurpose([out,retval] HSTRING *value);
        [propget] HRESULT Authority([out,retval] HSTRING *value);
    }
    [uuid(69473eb2-8031-49be-80bb-96cb46d99aba), exclusiveto(WebAccount)]
    interface IWebAccount : IInspectable {
        [propget] HRESULT WebAccountProvider([out,retval] WebAccountProvider **value);
        [propget] HRESULT UserName([out,retval] HSTRING *value);
        [propget] HRESULT State([out,retval] WebAccountState *value);
    }
    [uuid(7b56d6f8-990b-4eb5-94a7-5621f3a8b824), exclusiveto(WebAccount)]
    interface IWebAccount2 : IInspectable {
        [propget] HRESULT Id([out,retval] HSTRING *value);
        [propget] HRESULT Properties([out,retval] Windows.Foundation.Collections.IMapView<HSTRING,HSTRING> **value);
        HRESULT GetPictureAsync([in] WebAccountPictureSize size,[out,retval] Windows.Foundation.IAsyncOperation<Windows.Storage.Streams.IRandomAccessStream *> **value);
        HRESULT SignOutAsync([out,retval] Windows.Foundation.IAsyncAction **value);
        HRESULT SignOutWithClientIdAsync([in] HSTRING client,[out,retval] Windows.Foundation.IAsyncAction **value);
    }
    [contract(Windows.Foundation.UniversalApiContract,1.0)] runtimeclass WebAccountProvider { [default] interface IWebAccountProvider; interface IWebAccountProvider2; }
    [contract(Windows.Foundation.UniversalApiContract,1.0)] runtimeclass WebAccount { [default] interface IWebAccount; interface IWebAccount2; }
    declare {
        interface Windows.Foundation.AsyncOperationCompletedHandler<Windows.Security.Credentials.WebAccountProvider *>;
        interface Windows.Foundation.IAsyncOperation<Windows.Security.Credentials.WebAccountProvider *>;
        interface Windows.Foundation.AsyncOperationCompletedHandler<Windows.Security.Credentials.WebAccount *>;
        interface Windows.Foundation.IAsyncOperation<Windows.Security.Credentials.WebAccount *>;
    }
